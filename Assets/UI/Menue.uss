/* Menüs: helle, deckende Karten mit runden Ecken, Türkis als Akzent */

.wurzel {
    flex-grow: 1;
}

.bildschirm {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.bildschirm--abgedunkelt {
    background-color: rgba(4, 22, 32, 0.6);
}

.titel {
    font-size: 132px;
    -unity-font-style: bold;
    letter-spacing: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 6px 16px rgba(0, 35, 55, 0.65);
    margin-bottom: 0;
}

.untertitel {
    font-size: 28px;
    color: rgb(240, 251, 253);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 8px rgba(0, 35, 55, 0.7);
    margin-bottom: 40px;
}

.karte {
    width: 480px;
    padding: 30px 36px;
    background-color: rgb(250, 252, 252);
    border-radius: 24px;
    border-bottom-width: 6px;
    border-color: rgb(200, 224, 229);
}

.kartentitel {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.knopf {
    height: 64px;
    margin: 7px 0;
    border-radius: 16px;
    border-width: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
    background-color: rgb(233, 243, 245);
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.knopf:hover {
    background-color: rgb(212, 235, 239);
    scale: 1.03 1.03;
}

.knopf:active {
    scale: 0.97 0.97;
}

.knopf--haupt {
    background-color: rgb(16, 168, 184);
    color: rgb(255, 255, 255);
}

.knopf--haupt:hover {
    background-color: rgb(12, 148, 164);
}

.knopf--leise {
    height: 48px;
    font-size: 20px;
    color: rgb(88, 118, 128);
    background-color: rgba(0, 0, 0, 0);
}

.knopf--leise:hover {
    background-color: rgb(233, 243, 245);
}

.hinweis {
    font-size: 18px;
    color: rgb(88, 118, 128);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 14px;
    margin-bottom: 2px;
}

.eingabe {
    height: 56px;
    margin: 7px 0;
}

.eingabe > .unity-text-field__input {
    font-size: 24px;
    padding-left: 16px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(200, 224, 229);
    background-color: rgb(233, 243, 245);
    color: rgb(18, 58, 72);
    -unity-text-align: middle-left;
}

.meldung {
    font-size: 18px;
    color: rgb(196, 64, 64);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ---------- Anzeige im Spiel ---------- */

.anzeige {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    display: none;
}

.geldleiste {
    position: absolute;
    top: 24px;
    flex-direction: row;
    align-items: center;
    padding: 8px 28px;
    background-color: rgb(250, 252, 252);
    border-radius: 30px;
    border-bottom-width: 4px;
    border-color: rgb(200, 224, 229);
}

.geld {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
    margin-right: 10px;
}

.geld-einheit {
    font-size: 22px;
    color: rgb(16, 168, 184);
    -unity-font-style: bold;
}

.fadenkreuz {
    position: absolute;
    top: 50%; left: 50%;
    width: 8px; height: 8px;
    margin-left: -4px; margin-top: -4px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.9);
}

.hinweis-mitte {
    position: absolute;
    top: 54%;
    left: 0; right: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 6px rgba(0, 30, 45, 0.8);
}

.rampe-info {
    position: absolute;
    right: 28px;
    top: 110px;
    width: 320px;
    padding: 16px 20px;
    background-color: rgb(250, 252, 252);
    border-radius: 18px;
    border-bottom-width: 4px;
    border-color: rgb(200, 224, 229);
}

.rampe-titel {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(16, 168, 184);
    margin-bottom: 4px;
}

.rampe-zeile {
    font-size: 20px;
    color: rgb(18, 58, 72);
    white-space: normal;
}

.eimer-balken {
    width: 100%;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(225, 237, 240);
    overflow: hidden;
}

.eimer-fuellung {
    height: 100%;
    width: 0%;
    border-radius: 9px;
    background-color: rgb(16, 168, 184);
}

/* ---------- Shop ---------- */

.shop-karte {
    width: 820px;
    max-height: 86%;
}

.shop-kopf {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.shop-ueberschrift {
    margin-bottom: 0;
}

.shop-geld {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(16, 168, 184);
}

.shop-liste {
    flex-shrink: 1;
}

.shop-bereich {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(88, 118, 128);
    margin-top: 14px;
    margin-bottom: 4px;
    letter-spacing: 2px;
}

.shop-zeile {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 6px;
    border-radius: 14px;
    background-color: rgb(239, 246, 247);
}

.shop-texte {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
}

.shop-titel {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
}

.shop-text {
    font-size: 17px;
    color: rgb(88, 118, 128);
    white-space: normal;
}

.shop-knopf {
    width: 150px;
    height: 52px;
    margin: 0;
    font-size: 22px;
}

.shop-knopf:disabled {
    background-color: rgb(200, 214, 218);
    color: rgb(240, 245, 246);
    scale: 1 1;
}

/* ---------- Schnellleiste im Bild ---------- */

.schnellleiste {
    position: absolute;
    bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
}

.leiste-platz {
    width: 104px;
    height: 92px;
    margin: 0 4px;
    padding: 8px 10px;
    background-color: rgba(250, 252, 252, 0.92);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgb(200, 224, 229);
    overflow: hidden;
}

.leiste-platz--behaelter {
    width: 220px;
}

.leiste-platz--gewaehlt {
    border-color: rgb(16, 168, 184);
    translate: 0 -8px;
}

.leiste-taste {
    position: absolute;
    top: 4px;
    right: 9px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(140, 165, 172);
}

.leiste-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 4px;
}

.leiste-menge {
    font-size: 17px;
    color: rgb(88, 118, 128);
    margin-top: 4px;
}

/* ---------- Inventar und Kiste ---------- */

.inventar-reihe {
    flex-direction: row;
    align-items: flex-start;
}

.lager-karte {
    width: auto;
    margin: 0 14px;
}

.lager-raster {
    flex-direction: row;
    flex-wrap: wrap;
    width: 540px;
}

.lager-raster--kiste {
    width: 648px;
}

.lager-untertitel {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(88, 118, 128);
    margin-top: 14px;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.platz {
    width: 96px;
    height: 96px;
    margin: 6px;
    padding: 8px;
    border-radius: 14px;
    background-color: rgb(233, 243, 245);
    border-width: 2px;
    border-color: rgb(212, 230, 234);
    overflow: hidden;
}

.platz:hover {
    border-color: rgb(16, 168, 184);
}

.platz--gezogen {
    opacity: 0.35;
}

.platz-farbe {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 8px;
}

.leiste-platz > .platz-farbe {
    height: 6px;
}

.platz-taste {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(140, 165, 172);
}

.platz-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(18, 58, 72);
    white-space: normal;
    margin-top: 10px;
}

.platz-menge {
    position: absolute;
    bottom: 6px;
    right: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(16, 168, 184);
}

.inventar-tipp {
    margin-top: 16px;
    font-size: 18px;
    color: rgb(240, 251, 253);
    text-shadow: 0 2px 6px rgba(0, 30, 45, 0.8);
}

.platz-geist {
    position: absolute;
    width: 96px;
    height: 96px;
    padding: 8px;
    border-radius: 14px;
    background-color: rgba(16, 168, 184, 0.85);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    display: none;
}

.shop-meldung {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(196, 64, 64);
    background-color: rgb(253, 236, 234);
    border-radius: 12px;
    padding: 10px 14px;
    margin: 6px 0;
    white-space: normal;
    display: none;
}

/* ---------- Bildschirm (Satellitenbild) ---------- */

.bildschirm-hand {
    position: absolute;
    right: 40px;
    bottom: 140px;
    width: 470px;
    padding: 14px;
    background-color: rgb(34, 40, 48);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(70, 80, 92);
    display: none;
}

.bildschirm-hand--gross {
    left: 6%;
    right: 6%;
    top: 7%;
    bottom: 140px;
    width: auto;
}

.bildschirm-flaeche {
    flex-grow: 1;
    min-height: 246px;
    border-radius: 10px;
    background-color: rgb(6, 8, 14);
    overflow: hidden;
    justify-content: center;
}

.bildschirm-bild {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.bildschirm-status {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(150, 226, 236);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 20px;
}

.bildschirm-info {
    margin-top: 10px;
    font-size: 16px;
    color: rgb(200, 214, 220);
    white-space: normal;
}
